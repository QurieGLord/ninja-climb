{
  "name": "ninja-climb",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "package:yandex": "npm run build && node scripts/package-yandex.mjs",
    "assets:prepare": "node scripts/prepare-art.mjs",
    "test:perf": "npm run build && node scripts/perf-smoke.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.1",
    "fflate": "^0.8.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.4"
  }
}
